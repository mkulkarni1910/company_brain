# Azure resources — fill from `infra/provision.sh` output
AZURE_TENANT_ID=
AZURE_CLIENT_ID=               # Entra app for brain-api
AZURE_AI_SEARCH_ENDPOINT=      # https://<name>.search.windows.net
AZURE_AI_SEARCH_INDEX=brain-content-t-test
AZURE_OPENAI_ENDPOINT=         # https://<name>.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_PLAN_DEPLOYMENT=gpt-4-1-mini
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-large
AZURE_REDIS_HOST=              # <name>.redis.cache.windows.net
AZURE_REDIS_PORT=6380
AZURE_REDIS_SSL=true
AZURE_KEY_VAULT_URL=           # https://<name>.vault.azure.net
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Brain settings
BRAIN_TENANT_ID=t-test
BRAIN_LOG_LEVEL=INFO

# Entra API app
AZURE_API_CLIENT_ID=
AZURE_API_SCOPE=

# Dev-only: enable x-debug-bypass-auth header (eval harness + local testing). Keep false in prod.
ENABLE_DEBUG_AUTH=false
# Shared admin API key for POST /admin/ingest (empty = endpoint refuses all requests)
ADMIN_API_KEY=
